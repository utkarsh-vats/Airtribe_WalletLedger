# Copy to .env and adjust. .env is gitignored; never commit real secrets.

APP_ENV=dev
LOG_LEVEL=INFO

# --- Host port mappings (bound to 127.0.0.1 only) ---
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
API_HOST_PORT=8010

# --- Postgres superuser for the compose database ---
POSTGRES_USER=walletledger
POSTGRES_PASSWORD=change-me
POSTGRES_DB=walletledger

# --- Used by the app when running on the host (uv run ...). Containers build their own URLs. ---
DATABASE_URL=postgresql+asyncpg://walletledger:change-me@localhost:5433/walletledger
REDIS_URL=redis://localhost:6380/0
