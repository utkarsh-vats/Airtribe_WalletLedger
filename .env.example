# Optional: docker-compose.yml has local-dev defaults for every variable. Copy to .env only to
# override them. .env is gitignored; never commit real secrets.

APP_ENV=dev
LOG_LEVEL=INFO

# --- Host port mappings ---
# Postgres and Redis always bind to 127.0.0.1. The API binds to API_BIND_HOST.
# Docker-published ports bypass UFW: use a specific interface IP, never 0.0.0.0.
API_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
API_HOST_PORT=8010

# --- Postgres superuser for the compose database ---
POSTGRES_USER=walletledger
POSTGRES_PASSWORD=walletledger
POSTGRES_DB=walletledger
POSTGRES_TEST_DB=walletledger_test

# --- Application roles (created by docker/postgres/initdb on first volume init) ---
# wallet_owner runs migrations; wallet_app is the runtime role.
WALLET_OWNER_PASSWORD=wallet_owner
WALLET_APP_PASSWORD=wallet_app

# --- Used by the app when running on the host (uv run ...). Containers build their own URLs. ---
DATABASE_URL=postgresql+asyncpg://wallet_app:wallet_app@localhost:5433/walletledger
# Integration tests use only this database (name must end in _test).
TEST_DATABASE_URL=postgresql+asyncpg://wallet_app:wallet_app@localhost:5433/walletledger_test
REDIS_URL=redis://localhost:6380/0
